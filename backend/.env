# ===== CONFIGURAÇÕES DO BACKEND =====

# Porta do servidor
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dr-marcos-ferrao
# Ou use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/dr-marcos-ferrao

# JWT Secret (altere para algo seguro)
JWT_SECRET=sua-chave-secreta-super-segura-aqui

# Email (Gmail)
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-gmail

# Email do escritório
ESCRITORIO_EMAIL=contato@ferraoadvogados.adv.br

# URL do site
SITE_URL=https://ferraoadvogados.adv.br

# Ambiente
NODE_ENV=production
